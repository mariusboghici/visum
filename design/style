* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: #0d0d11;
    color: #e2e8f0;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
    padding: 20px 15px;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
}

.site-header {
    text-align: center;
    margin-bottom: 40px;
}

.logo {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: #ffffff;
}

.tagline {
    color: #888899;
    font-size: 0.95rem;
    margin-top: 4px;
}

.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
}

.back-link {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
}

.back-link:hover {
    color: #2563eb;
    text-decoration: underline;
}

.divider {
    border: none;
    border-top: 1px solid #2a2a32;
}

/* Banner Panoramic sus - Rezolvare cadru alb */
.featured-banner {
    background-color: #ffffff;
    border: 1px solid #33333d;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 35px;
    cursor: pointer;
    padding: 15px;
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.featured-banner:hover {
    border-color: #3b82f6;
    transform: translateY(-2px);
}

.featured-banner img {
    width: 100%;
    height: auto;
    max-height: 140px;
    display: block;
    object-fit: contain;
}

/* Grid Carduri */
.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

/* Carduri cu fundal neutru deschis (#22242b) - oferă contrast impecabil pentru tot ce e închis la culoare */
.gallery-item {
    background: #22242b;
    border: 1px solid #333642;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    outline: none;
    height: 200px;
}

.gallery-item:hover {
    transform: translateY(-4px);
    border-color: #3b82f6;
    background: #2a2d37;
    box-shadow: 0 10px 20px rgba(0,0,0,0.4);
}

.gallery-item img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
}

.site-footer {
    text-align: center;
    margin-top: 50px;
    padding-top: 20px;
    border-top: 1px solid #1a1a22;
    color: #666677;
    font-size: 0.85rem;
}

.footer-phone-link {
    color: inherit;
    text-decoration: none;
}

/* Lightbox */
dialog#lightbox {
    padding: 0;
    background: transparent;
    border: none;
    max-width: 90vw;
    max-height: 90vh;
    margin: auto;
    border-radius: 12px;
    overflow: hidden;
}

dialog#lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(6px);
}

dialog#lightbox img {
    max-width: 90vw;
    max-height: 85vh;
    display: block;
    object-fit: contain;
    background: #111;
    padding: 20px;
}

.close-btn {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    font-size: 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
}